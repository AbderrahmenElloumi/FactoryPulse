# FactoryPulse Environment Configuration

# MinIO Object Storage Credentials (Dev / Local)
MINIO_ACCESS_KEY=factorypulse
MINIO_SECRET_KEY=factorypulse-dev-pass
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=factorypulse

# Airflow (ticket 06): the repository's path as the Docker daemon sees it.
# Airflow's tasks run `docker compose` against the host daemon, which resolves
# the job services' bind mounts (./spark, ./src, ./dbt) against this path.
#   Linux, macOS:            the repository's absolute path, e.g. /home/me/DataEngProj
#   Windows, Docker Desktop: /run/desktop/mnt/host/c/Users/me/DataEngProj
FACTORYPULSE_HOST_DIR=/run/desktop/mnt/host/c/Users/me/DataEngProj
# Shared by the Airflow processes to sign task tokens (dev value).
AIRFLOW_JWT_SECRET=factorypulse-dev-jwt-secret

# Kafka Configuration
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=sensor-events
